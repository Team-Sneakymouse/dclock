<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://dclock.rawb.tv/" />
		<meta property="og:title" content="Monica's DClock" />
		<meta property="og:description" content="<%= seconds %> seconds left~" />
		<meta property="og:image" content="https://dclock.rawb.tv/assets/robMonica.png" />
		<meta name="theme-color" content="#ED4AF3" />

		<link rel="icon" type="image/png" href="assets/robMyGoodness.png" />
		<title>DClock</title>
		<style>
			@font-face {
				font-family: "blue-highway";
				src: url("assets/blue-highway-d.ttf");
			}
			html,
			body {
				height: 100%;
				margin: 0;
				padding: 0;
				overflow: hidden;
			}
			body {
				font-family: blue-highway;
				font-size: calc(100vw / 12 * 2.2);
				color: rgb(237, 74, 243);
				text-shadow: 2px 2px 4px rgb(163, 8, 168);
				background-color: rgb(141, 218, 241);
			}
			.container {
				display: flex;
				justify-content: center;
				align-items: center;
				height: 100%;
			}
			#clock {
				width: calc(100vw / 14 * 8);
			}

			* {
				-moz-user-select: -moz-none;
				-khtml-user-select: none;
				-webkit-user-select: none;
				-ms-user-select: none;
				user-select: none;
			}
		</style>
		<script type="module">
			// The amount only changes when someone adjusts it; show the latest one the server sends.
			function show(value) {
				const seconds = Math.max(0, Math.floor(Number(value)));
				if (!Number.isFinite(seconds)) return;
				document.getElementById("clock").textContent = seconds.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			}

			// The server-rendered value stays if this fails; EventSource reconnects on its own.
			if ("EventSource" in window) {
				const events = new EventSource("/events");
				events.onmessage = (event) => show(event.data);
			}
		</script>
	</head>
	<body>
		<div class="container">
			<div id="clock"><%= seconds %></div>
		</div>
	</body>
</html>
